rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Todo o acesso a dados de saldo passa OBRIGATORIAMENTE pelo backend
    // (que usa a chave de admin, ignorando estas regras). O cliente nunca
    // lê nem escreve o Firestore diretamente — isso impede que alguém
    // manipule o próprio saldo no browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
